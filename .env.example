# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_NAME=self-healing-data-pipeline
APP_ENV=development
SECRET_KEY=<generate-a-random-secret-key>

# --- Database ---
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
DB_HOST=<host>
DB_PORT=<port>
DB_NAME=<database>
DB_USER=<user>
DB_PASSWORD=<password>

# --- LLM provider selection ---
# "azure_openai" is the specification's intended production provider.
# "groq" is a TEMPORARY development-only stand-in, used only until the
# team provides Azure OpenAI credentials.
LLM_PROVIDER=azure_openai

# --- Azure OpenAI (production) ---
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=<https://your-resource.openai.azure.com>
AZURE_OPENAI_API_VERSION=<api-version>
AZURE_OPENAI_DEPLOYMENT_NAME=<deployment-name>

# --- Groq (TEMPORARY development provider only; required when LLM_PROVIDER=groq) ---
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=<verified-groq-model-id>
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- MLflow ---
MLFLOW_TRACKING_URI=<mlflow-tracking-uri>
MLFLOW_EXPERIMENT_NAME=<experiment-name>

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=<json-or-console>

# --- Databricks (reserved, not yet enabled) ---
# DATABRICKS_HOST=<workspace-url>
# DATABRICKS_TOKEN=<databricks-access-token>
# DATABRICKS_CLUSTER_ID=<cluster-id>

# --- ADF Run ID (reserved, not yet enabled) ---
# ADF_RUN_ID=<adf-pipeline-run-id>
# ADF_FACTORY_NAME=<adf-factory-name>