# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_NAME=self-healing-data-pipeline
APP_ENV=development
SECRET_KEY=<generate-a-random-secret-key>

# --- Database ---
# Local development defaults matching docker-compose.yml's PostgreSQL
# service (see that file). These are LOCAL DEV credentials ONLY — never
# production-safe; override for any real deployment. The host
# application connects via "localhost" and the published DB_PORT; the
# MLflow container instead connects via the "postgres" Compose service
# hostname internally (see docker-compose.yml for why).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/self_healing_pipeline
DB_HOST=localhost
DB_PORT=5432
DB_NAME=self_healing_pipeline
DB_USER=postgres
DB_PASSWORD=postgres

# --- LLM provider selection ---
# "azure_openai" is the specification's intended production provider.
# "groq" is a TEMPORARY development-only stand-in, used only until the
# team provides Azure OpenAI credentials.
LLM_PROVIDER=azure_openai

# --- Azure OpenAI (production) ---
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_ENDPOINT=<https://your-resource.openai.azure.com>
AZURE_OPENAI_API_VERSION=<api-version>
AZURE_OPENAI_DEPLOYMENT_NAME=<deployment-name>

# --- Groq (TEMPORARY development provider only; required when LLM_PROVIDER=groq) ---
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=<verified-groq-model-id>
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- MLflow ---
# Local self-hosted MLflow Tracking Server (see docker-compose.yml),
# backed by the same PostgreSQL instance above. LOCAL DEV ONLY.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=tier1-csv-repair
# Host port docker-compose.yml publishes the MLflow server on; not read
# by MLflowSettings itself (only MLFLOW_TRACKING_URI is), only by
# docker-compose.yml's own port mapping. Change together with the port
# in MLFLOW_TRACKING_URI above if you override it.
# MLFLOW_PORT=5000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=<json-or-console>

# --- Elasticsearch / Kibana (local log search, see docker-compose.yml) ---
# Not read by the application itself — only by docker-compose.yml's own
# port mappings and Filebeat, which ships the app's existing structured
# JSON logs (logs/self_healing_pipeline.log) to Elasticsearch. Change
# together if you override these host ports.
# ELASTICSEARCH_PORT=9200
# KIBANA_PORT=5601

# --- Databricks (reserved, not yet enabled) ---
# DATABRICKS_HOST=<workspace-url>
# DATABRICKS_TOKEN=<databricks-access-token>
# DATABRICKS_CLUSTER_ID=<cluster-id>

# --- ADF Run ID (reserved, not yet enabled) ---
# ADF_RUN_ID=<adf-pipeline-run-id>
# ADF_FACTORY_NAME=<adf-factory-name>